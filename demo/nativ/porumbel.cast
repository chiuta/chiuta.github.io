[4.03,"o","\r\n"]
[4.03,"o","PORUMBEL — carries photos from Open Camera (phone) into a folder on this computer and\r\n"]
[4.1,"o","hands them to LegatorOCR.  /  Duce pozele din Open Camera în folderul de pe calculator\r\n"]
[4.17,"o","și le deschide în LegatorOCR.\r\n"]
[4.24,"o","\r\n"]
[4.31,"o","USAGE\r\n"]
[4.38,"o","  porumbel [options]            run (server, ADB and folder watchers as configured)\r\n"]
[4.45,"o","  porumbel init                 create the settings file and print where it is\r\n"]
[4.52,"o","  porumbel qr                   print the QR code for the phone and exit\r\n"]
[4.59,"o","  porumbel open-last            open the newest session in LegatorOCR and exit\r\n"]
[4.66,"o","  porumbel forget               forget which photos were already received\r\n"]
[4.73,"o","  porumbel print-config         show the effective settings\r\n"]
[4.8,"o","  porumbel doctor               check folder, port, adb, phone and LegatorOCR\r\n"]
[4.87,"o","\r\n"]
[4.94,"o","OPTIONS (same names as in the settings file)\r\n"]
